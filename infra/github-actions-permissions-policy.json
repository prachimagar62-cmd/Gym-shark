{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindTheTaggedStoreInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "WaitForSystemsManagerRegistration",
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*"
    },
    {
      "Sid": "UseOnlyTheApprovedDeploymentDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:YOUR_AWS_REGION::document/AWS-RunShellScript"
    },
    {
      "Sid": "SendDeploymentCommandsToThisStoreOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/GymsharkApp": "GymsharkStore"
        }
      }
    },
    {
      "Sid": "ReadDeploymentCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}