# Copy this file to .env for local development. Never commit .env to Git.

PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/gymshark

# For production, set MONGO_URI to your MongoDB Atlas connection string in AWS Secrets Manager.

# Generate a local value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-hex-secret
