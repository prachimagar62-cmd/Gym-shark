# ─── Gymshark Backend Environment Variables Template ──────────────────────────
# Copy to .env for local development. Never commit .env to Git.

PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/gymshark

# Production MongoDB Atlas (Cluster 0):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.4i4h5r0.mongodb.net/gymshark?retryWrites=true&w=majority

JWT_SECRET=gymshark_secret_jwt_key_2026
